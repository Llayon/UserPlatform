# Server-only secrets (NEVER prefix with VITE_, never commit real values)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
# Per-app service credentials are DB-backed (service_credentials table).
# Create them with the operator CLI (token prints ONCE, hash-only storage):
#   npm run service:create -- --app fridge --label holodilnik-prod
# There is NO global PLATFORM_SERVICE_TOKEN (removed in Gauntlet 1).
PORT=3002
# Welcome/session knobs (server-only, have safe defaults)
# WELCOME_BONUS_CREDITS=10
# SESSION_TTL_SECONDS=2592000
# Dev mock exchange personas (dev only; NEVER true in production)
# PLATFORM_ALLOW_DEV_AUTH=false

# Public-safe values (may be exposed to browser)
# VITE_PLATFORM_API_URL=http://localhost:3002
