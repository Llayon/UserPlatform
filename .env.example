# Server-only secrets (NEVER prefix with VITE_, never commit real values)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
PLATFORM_SERVICE_TOKEN=
# Previous service token honored during rotation grace (server-only).
# 1) set PREVIOUS=<old>, deploy; 2) rotate backends to new token;
# 3) unset PREVIOUS, deploy. Never commit real values.
# PLATFORM_SERVICE_TOKEN_PREVIOUS=
PORT=3002
# Welcome/session knobs (server-only, have safe defaults)
# WELCOME_BONUS_CREDITS=10
# SESSION_TTL_SECONDS=2592000
# Dev mock exchange personas (dev only; NEVER true in production)
# PLATFORM_ALLOW_DEV_AUTH=false

# Public-safe values (may be exposed to browser)
# VITE_PLATFORM_API_URL=http://localhost:3002
