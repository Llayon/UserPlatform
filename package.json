{
  "name": "user-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b",
    "test:e2e": "npm run build --workspace=@user-platform/account && playwright test --config apps/account/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
