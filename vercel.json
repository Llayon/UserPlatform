{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run build --workspace=@user-platform/account",
  "outputDirectory": "apps/account/dist",
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" }
  ]
}
